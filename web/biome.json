{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**/*.{js,ts,jsx,tsx}",
      "*.{js,ts,jsx,tsx}",
      "!src/lib/generated/**/*.ts",
      "!src/api/generated.ts",
      "!src/api/schemas/**/*.ts",
      "!src/api/openapi.json",
      "!index.html",
      "!test-results",
      "!playwright-report"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedInterfaceMembers": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImplicitCoercions": "error",
        "noUselessFragments": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noUnusedTemplateLiteral": "error",
        "useBlockStatements": "off",
        "useNamingConvention": "off",
        "noMagicNumbers": "off",
        "noIncrementDecrement": "off"
      },
      "performance": {
        "noImgElement": "off",
        "noNamespaceImport": "off",
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noUnknownAtRules": "off",
        "noAlert": "error",
        "noUnnecessaryConditions": "off"
      },
      "a11y": {
        "noAutofocus": "error",
        "useValidAnchor": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    },
    "globals": ["__APP_VERSION__", "__COMMIT_HASH__"]
  },
  "overrides": [
    {
      "includes": [
        "**/*.spec.{ts,tsx,js,jsx}",
        "**/*.test.{ts,tsx,js,jsx}",
        "e2e/**/*.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": ["vite.config.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ],
  "extends": ["ultracite/biome/core"]
}
