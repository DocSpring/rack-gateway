FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS dev

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies with BuildKit cache
RUN bun install --frozen-lockfile

# Expose Vite dev server port
EXPOSE 5173

# Start dev server
CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0"]
