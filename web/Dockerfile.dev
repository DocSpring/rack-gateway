FROM oven/bun:1.4.3-alpine@sha256:629e17411f1f129dbec3af78d5af9c9f2a937435c80349437206c6b0b7422373 AS dev

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies with BuildKit cache
RUN bun install --frozen-lockfile

# Expose Vite dev server port
EXPOSE 5173

# Start dev server
CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0"]
