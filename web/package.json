{
  "name": "web",
  "version": "0.1.22",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx tsc -b tsconfig.build.json && bunx vite build",
    "build:fast": "bunx vite build --mode development",
    "dev": "bunx vite --clearScreen false",
    "e2e": "node ./scripts/run-e2e.mjs",
    "e2e:ui": "bunx playwright test --ui",
    "format": "bunx biome format --write .",
    "generate:client": "bunx orval --config orval.config.ts",
    "generate:openapi": "bunx swagger2openapi ../internal/gateway/openapi/generated/swagger.json --outfile src/api/openapi.json --yaml=false && echo >> src/api/openapi.json",
    "knip": "bunx knip",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "lint:unsafe": "bunx biome check --write --unsafe .",
    "preview": "bunx vite preview",
    "test": "bunx vitest",
    "test:coverage": "bunx vitest --coverage",
    "test:ui": "bunx vitest --ui",
    "typecheck": "bunx tsc -b --noEmit --pretty false"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.1"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sentry/react": "11.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hot-toast": "github:DocSpring/react-hot-toast#fix/csp-inline-styles-dist",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "orval": "^8.41.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "ultracite": "7.12.4",
    "vite": "^8.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.4.2"
}
