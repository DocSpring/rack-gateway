{
  "name": "mock-oauth-server",
  "version": "1.0.0",
  "description": "Mock Google OAuth server for development",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "bunx tsc --project tsconfig.build.json",
    "start": "bun run build && bun dist/server.js",
    "dev": "bun --watch src/server.ts",
    "test": "SKIP_AUTOSTART=true bun test tests",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "typecheck": "bunx tsc -b --noEmit --pretty false"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "bun-types": "^1.4.3",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "ultracite": "^8.0.0"
  }
}
