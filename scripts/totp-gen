#!/usr/bin/env bash
# Wrapper for bin/totp-gen - build and run
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
BIN="$ROOT_DIR/bin/totp-gen"

# Build if missing or older than its sources
if [[ ! -f "$BIN" ]] || [[ -n "$(find "$ROOT_DIR/cmd/totp-gen" "$ROOT_DIR/internal/gateway/colcrypt" -name '*.go' -newer "$BIN")" ]]; then
    echo "Building totp-gen..." >&2
    # Build output goes to stderr: callers capture this script's stdout (a code or an encrypted secret).
    (cd "$ROOT_DIR" && task go:build:totp-gen) >&2
fi

exec "$BIN" "$@"
